@model Listing
@{
    ViewData["Title"] = "Add Listing";
}

<h2 class="mb-4">Add Listing</h2>
<form asp-action="CreateListing" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Title</label><input asp-for="Title" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Price (৳)</label><input asp-for="Price" class="form-control" /></div>
        <div class="col-md-3">
            <label class="form-label">Category</label>
            <select asp-for="Category" class="form-select">
                <option value="Room">Room</option>
                <option value="TourPackage">Tour Package</option>
                <option value="TransportService">Transport Service</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Destination (optional)</label>
            <select asp-for="DestinationId" class="form-select">
                <option value="">-- Not tied to a specific destination --</option>
                @foreach (var d in (List<Destination>)ViewBag.Destinations)
                {
                    <option value="@d.Id">@d.Name (@d.District)</option>
                }
            </select>
        </div>
    <button type="submit" class="btn btn-success mt-3">Save</button>
    <a asp-action="Listings" class="btn btn-secondary mt-3">Cancel</a>
</form>