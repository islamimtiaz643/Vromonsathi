@model List<Listing>
@{
    ViewData["Title"] = "My Listings";
}

<div class="d-flex justify-content-between mb-3">
    <h2>My Listings</h2>
    <a asp-action="CreateListing" class="btn btn-success">+ Add Listing</a>
</div>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Title</th><th>Category</th><th>Price</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td>@l.Title</td>
                    <td>@l.Category</td>
                    <td>৳@l.Price</td>
                    <td>@(l.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <a asp-action="EditListing" asp-route-id="@l.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="DeleteListing" asp-route-id="@l.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this listing?');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>