@model List<BusBooking>
@{
    ViewData["Title"] = "Route Bookings"; var route = ViewBag.Route as BusRoute;
}

<h2 class="mb-4">Bookings — @route.OriginCity → @route.DestinationCity (@route.BusName)</h2>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Traveler</th><th>Travel Date</th><th>Seats</th><th class="num">Total</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.TouristUser.FullName</td>
                    <td>@b.TravelDate.ToString("dd MMM yyyy")</td>
                    <td>@b.SeatNumbers</td>
                    <td class="num">৳@b.TotalPrice</td>
                    <td><span class="badge bg-@(b.Status == "Confirmed" ? "success" : "danger")">@b.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p class="text-muted">No bookings on this route yet.</p>
}
<a asp-action="BusRoutes" class="btn btn-secondary mt-3">Back to Routes</a>