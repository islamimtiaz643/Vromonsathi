@model VendorPackageOffer
@{
    ViewData["Title"] = "Offer Services"; var pkg = ViewBag.Package as TourPackage;
}

<h2 class="mb-2">Offer Services — @pkg.Title</h2>
<p class="text-muted mb-4">This offer must be approved by admin before travelers can see it.</p>

<form asp-action="CreateOffer" method="post">
    <input type="hidden" asp-for="TourPackageId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Offer Title</label><input asp-for="Title" class="form-control" placeholder="e.g. AC Room Upgrade" /></div>
        <div class="col-md-3"><label class="form-label">Price (৳ per person)</label><input asp-for="Price" class="form-control" /></div>
        <div class="col-md-3">
            <label class="form-label">Category</label>
            <select asp-for="Category" class="form-select">
                <option value="Hotel">Hotel</option>
                <option value="Transport">Transport</option>
                <option value="Meals">Meals</option>
                <option value="OtherFacility">Other Facility</option>
            </select>
        </div>
        <div class="col-12"><label class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
    </div>
    <button type="submit" class="btn btn-success mt-3">Submit Offer</button>
    <a asp-action="BrowsePackages" class="btn btn-secondary mt-3">Cancel</a>
</form>