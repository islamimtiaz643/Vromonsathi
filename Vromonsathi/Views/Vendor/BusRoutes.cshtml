@model List<BusRoute>
@{
    ViewData["Title"] = "My Bus Routes";
}

<div class="d-flex justify-content-between mb-3">
    <h2>My Bus Routes</h2>
    <a asp-action="CreateBusRoute" class="btn btn-success">+ Add Bus Route</a>
</div>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Route</th><th>Bus</th><th>Departure</th><th>Price/Seat</th><th>Total Seats</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.OriginCity → @r.DestinationCity @(r.Destination != null ? $"({r.Destination.Name})" : "")</td>
                    <td>@r.BusName (@r.BusType)</td>
                    <td>@r.DepartureTime</td>
                    <td>৳@r.PricePerSeat</td>
                    <td>@r.TotalSeats</td>
                    <td>@(r.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <a asp-action="EditBusRoute" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="BusRouteBookings" asp-route-routeId="@r.Id" class="btn btn-sm btn-outline-secondary">Bookings</a>
                        <a asp-action="DeleteBusRoute" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this route?');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p class="text-muted">No bus routes added yet.</p>
}