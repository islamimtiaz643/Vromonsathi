@model List<Booking>
@{
    ViewData["Title"] = "Manage Bookings";
}

<h2 class="mb-4">Bookings</h2>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Tourist</th><th>Listing</th><th>Date</th><th>People</th><th>Total</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.TouristUser.FullName</td>
                    <td>@b.Listing.Title</td>
                    <td>@b.StartDate.ToString("dd MMM yyyy")</td>
                    <td>@b.NumberOfPeople</td>
                    <td>৳@b.TotalPrice</td>
                    <td>
                        <span class="badge bg-@(b.Status == "Confirmed" ? "success" : b.Status == "Cancelled" ? "danger" : b.Status == "Completed" ? "secondary" : "warning")">@b.Status</span>
                    </td>
                    <td>
                        @if (b.Status == "Pending")
                        {
                            <a asp-action="UpdateBookingStatus" asp-route-id="@b.Id" asp-route-status="Confirmed" class="btn btn-sm btn-success">Confirm</a>
                            <a asp-action="UpdateBookingStatus" asp-route-id="@b.Id" asp-route-status="Cancelled" class="btn btn-sm btn-danger">Cancel</a>
                        }
                        @if (b.Status == "Confirmed")
                        {
                            <a asp-action="UpdateBookingStatus" asp-route-id="@b.Id" asp-route-status="Completed" class="btn btn-sm btn-secondary">Mark Completed</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>