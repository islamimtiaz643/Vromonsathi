@model List<WalletTransaction>
@{ ViewData["Title"] = "My Earnings"; }

<h2 class="mb-2">My Earnings Wallet</h2>
<div class="card text-white bg-success mb-4" style="max-width:260px;">
    <div class="card-body">
        <h6>Balance</h6>
        <h3>৳@(((decimal)ViewBag.WalletBalance).ToString("N0"))</h3>
    </div>
</div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead><tr><th>Note</th><th>Date</th><th>Amount</th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr><td>@t.ReceiptNote</td><td>@t.CreatedAt.ToString("dd MMM yyyy")</td><td>৳@t.Amount</td></tr>
    }
    </tbody>
</table>
</div>
@if (!Model.Any())
{
    <p class="text-muted">No earnings yet.</p>
}