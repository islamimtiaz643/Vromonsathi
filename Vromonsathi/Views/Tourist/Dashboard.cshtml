@model List<Booking>
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="wrap" style="padding:40px 28px;">
    <span class="tag">Traveler panel</span>
    <h2 style="margin-bottom:24px;">My Dashboard</h2>

    @{
        var refundNotices = ViewBag.RefundNotices as List<Booking>;
    }
    @if (refundNotices != null && refundNotices.Count > 0)
    {
        <div class="alert-box" style="border-color:var(--red); background:#FBEAE8;">
            <strong>@refundNotices.Count booking(s) cancelled by admin — refund pending.</strong>
            <div style="margin-top:6px; font-size:12.5px;">
                @foreach (var rn in refundNotices)
                {
                    <div style="margin-top:4px;">@rn.CancellationNote</div>
                }
            </div>
        </div>
    }

    <div class="stat-grid">
        <div class="stat-card"><div class="label">Total Bookings</div><div class="value">@ViewBag.TotalBookings</div></div>
        <div class="stat-card"><div class="label">Pending</div><div class="value">@ViewBag.PendingBookings</div></div>
        <div class="stat-card"><div class="label">Confirmed</div><div class="value">@ViewBag.ConfirmedBookings</div></div>
        <div class="stat-card"><div class="label">Completed</div><div class="value">@ViewBag.CompletedBookings</div></div>
        <div class="stat-card"><div class="label">Wallet Balance</div><div class="value">৳@(((decimal)ViewBag.WalletBalance).ToString("N0"))</div></div>
    </div>

    <div class="action-grid">
        <a asp-controller="Destination" asp-action="Index" class="btn btn-ghost">Browse Destinations</a>
        <a asp-action="MyBookings" class="btn btn-ghost">My Bookings</a>
        <a asp-action="MyWallet" class="btn btn-ghost">My Wallet</a>
    </div>

    <div class="section-head" style="margin-top:40px;">
        <div><span class="tag">Recent activity</span><h2 style="font-size:20px;">Recent Bookings</h2></div>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Listing</th><th>Date</th><th class="num">Total</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    var badgeClass = b.Status switch { "Confirmed" => "badge-confirmed", "Cancelled" => "badge-cancelled", "Completed" => "badge-completed", _ => "badge-pending" };
                    var itemTitle = b.Listing?.Title ?? b.TourPackage?.Title ?? "—";
                    <tr>
                        <td>@itemTitle</td>
                        <td>@b.StartDate.ToString("dd MMM yyyy")</td>
                        <td class="num">৳@b.TotalPrice</td>
                        <td>
                            <span class="badge @badgeClass">@b.Status</span>
                            @if (b.Status == "Cancelled" && !string.IsNullOrEmpty(b.CancellationNote))
                            {
                                <div style="font-size:11px; color:var(--red); margin-top:4px;">@b.CancellationNote</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <p style="opacity:0.7; margin-top:16px;">No bookings yet. <a asp-controller="Destination" asp-action="Index">Explore destinations</a> to get started.</p>
    }
</div>