@model List<BusBooking>
@{
    ViewData["Title"] = "My Bus Bookings";
}

<div class="wrap" style="padding:40px 28px;">
    <h2 style="margin-bottom:24px;">My Bus Bookings</h2>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Route</th><th>Bus</th><th>Travel Date</th><th>Seats</th><th class="num">Total</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.BusRoute!.OriginCity → @b.BusRoute.DestinationCity</td>
                        <td>@b.BusRoute.BusName</td>
                        <td>@b.TravelDate.ToString("dd MMM yyyy")</td>
                        <td>@b.SeatNumbers</td>
                        <td class="num">৳@b.TotalPrice</td>
                        <td><span class="badge @(b.Status == "Confirmed" ? "badge-confirmed" : "badge-cancelled")">@b.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <p style="opacity:0.7; margin-top:16px;">No bus bookings yet.</p>
    }
</div>