@model List<Facility>
@{
    ViewData["Title"] = "Facilities";
}

<section>
    <div class="wrap">
        <div class="section-head">
            <div>
                <span class="tag">Required facilities</span>
                <h2>Add what you need — nothing you don't</h2>
                <p>Baseline rates used by the estimator when no vendor listing is available yet.</p>
            </div>
        </div>

        <div class="fac-grid">
            @foreach (var f in Model)
            {
                <div class="fac-card">
                    <h4>@f.NameEn</h4>
                    <p>@f.Description</p>
                    <p class="mono" style="margin-top:10px; color:var(--forest); font-weight:600;">
                        ৳@f.DefaultPrice.ToString("N0") <span style="opacity:0.6; font-weight:400;">/ @f.Unit</span>
                    </p>
                </div>
            }
        </div>

        <div class="hero-actions" style="margin-top:32px;">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Build a plan with these facilities</a>
        </div>
    </div>
</section>