<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Vromonsathi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+Bengali:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@inject Vromonsathi.Data.ApplicationDbContext DbContext
<body>

    <header>
        <nav>
            <a class="logo" asp-controller="Home" asp-action="Index" style="text-decoration:none;">
                <svg class="logo-mark" viewBox="0 0 34 34" fill="none">
                    <circle cx="17" cy="17" r="16" stroke="#0F3D2E" stroke-width="1.4" />
                    <path d="M6 20 Q11 14 17 18 T28 14" stroke="#1C6B74" stroke-width="1.4" fill="none" />
                    <path d="M4 24 Q11 19 17 23 T30 18" stroke="#D9A544" stroke-width="1.2" fill="none" opacity="0.8" />
                    <circle cx="17" cy="17" r="2.4" fill="#0F3D2E" />
                </svg>
                <div class="logo-text">
                    <span class="bn">ভ্রমণসাথী</span>
                    <span class="en">Vromonsathi</span>
                </div>
            </a>
            <div class="navlinks">
                <a href="~/#estimator">Plan &amp; Budget</a>
                <a asp-controller="Destination" asp-action="Index">Destinations</a>
                <a href="~/#routes">Routes &amp; Checkpoints</a>
                <a asp-controller="Facilities" asp-action="Index">Facilities</a>
                <a asp-controller="Bus" asp-action="Index">Bus Tickets</a>
                <a asp-controller="Emergency" asp-action="Index">Emergency Aid</a>
            </div>
            <div class="nav-cta">
                @if (Context.Session.GetInt32("UserId") == null)
                {
                    <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a>
                }
                else
                {
                    var role = Context.Session.GetString("Role");
                    var currentUserId = Context.Session.GetInt32("UserId");
                    var unreadCount = currentUserId != null ? DbContext.Notifications.Count(n => n.UserId == currentUserId && !n.IsRead) : 0;

                    @if (role == "Admin")
                    {
                        <a class="btn btn-ghost" asp-controller="Admin" asp-action="Dashboard">Admin Dashboard</a>
                    }
                    @if (role == "Vendor")
                    {
                        <a class="btn btn-ghost" asp-controller="Vendor" asp-action="Dashboard">Vendor Dashboard</a>
                    }
                    @if (role == "Tourist")
                    {
                        <a class="btn btn-ghost" asp-controller="Tourist" asp-action="Dashboard">My Dashboard</a>
                    }
                    <a asp-controller="Notifications" asp-action="Index" style="position:relative; display:inline-flex; align-items:center; justify-content:center; width:38px; height:38px; border:1px solid var(--forest); border-radius:8px; flex:none;" title="Notifications">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0F3D2E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        @if (unreadCount > 0)
                        {
                            <span style="position:absolute; top:-6px; right:-6px; background:var(--red); color:#fff; border-radius:50%; min-width:16px; height:16px; font-size:10px; display:flex; align-items:center; justify-content:center; padding:0 3px; line-height:1;">@unreadCount</span>
                        }
                    </a>
                    <span class="user-chip">Hi, @Context.Session.GetString("FullName")</span>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Logout">Logout</a>
                }
            </div>
        </nav>
    </header>

    @if (TempData["Message"] != null)
    {
        <div class="wrap" style="padding-top:18px;">
            <div class="alert-box">@TempData["Message"]</div>
        </div>
    }

    @RenderBody()

    <footer>
        <div class="wrap">
            <div class="footer-grid">
                <div>
                    <div class="logo" style="margin-bottom:14px;">
                        <svg class="logo-mark" viewBox="0 0 34 34" fill="none">
                            <circle cx="17" cy="17" r="16" stroke="#F4F0E4" stroke-width="1.4" />
                            <path d="M6 20 Q11 14 17 18 T28 14" stroke="#D9A544" stroke-width="1.4" fill="none" />
                        </svg>
                        <div class="logo-text">
                            <span class="bn" style="color:#F4F0E4;">ভ্রমণসাথী</span>
                            <span class="en" style="color:#D9A544;">Vromonsathi</span>
                        </div>
                    </div>
                    <p style="font-size:13px; opacity:0.7; max-width:280px;">Smart tourism planning for Bangladesh — dynamic budgets, destination plans, bookings, and safety, built for the way people actually travel here.</p>
                </div>
                <div>
                    <h4>Plan</h4>
                    <div class="flinks">
                        <a href="~/#estimator">Budget estimator</a>
                        <a asp-controller="Destination" asp-action="Index">Destinations</a>
                        <a href="~/#routes">Routes &amp; checkpoints</a>
                    </div>
                </div>
                <div>
                    <h4>Travelers</h4>
                    <div class="flinks">
                        <a asp-controller="Account" asp-action="Register">Sign up</a>
                        <a asp-controller="Tourist" asp-action="MyBookings">My bookings</a>
                        <a asp-controller="Emergency" asp-action="Index">Emergency aid</a>
                    </div>
                </div>
                <div>
                    <h4>Partners</h4>
                    <div class="flinks">
                        <a asp-controller="Account" asp-action="Register">List your hotel</a>
                        <a asp-controller="Account" asp-action="Register">Register as a guide</a>
                        <a asp-controller="Vendor" asp-action="Dashboard">Vendor dashboard</a>
                    </div>
                </div>
            </div>
            <div class="foot-bottom">
                <span>© 2026 Vromonsathi</span>
                <span><a asp-controller="Home" asp-action="Terms">Terms</a> · <a asp-controller="Home" asp-action="Privacy">Privacy</a> · বাংলা / English</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <div id="chatWidget" style="position:fixed; bottom:20px; right:20px; z-index:200;">
  <button id="chatToggle" style="width:56px; height:56px; border-radius:50%; background:var(--forest); border:none; cursor:pointer; box-shadow:0 8px 20px rgba(15,35,26,0.3); display:flex; align-items:center; justify-content:center;">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F4F0E4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>

  <div id="chatPanel" style="display:none; position:absolute; bottom:70px; right:0; width:340px; max-width:90vw; height:460px; background:var(--card); border:1px solid var(--line); border-radius:16px; box-shadow:0 24px 60px -20px rgba(15,35,26,0.4); overflow:hidden; flex-direction:column;">
    <div style="background:var(--forest); color:var(--paper); padding:14px 16px; display:flex; justify-content:space-between; align-items:center;">
      <div>
        <div style="font-weight:600; font-size:14px;">Vromonsathi Assistant</div>
        <div style="font-size:11px; opacity:0.7;">Ask about destinations, packages, or your bookings</div>
      </div>
      <button id="chatClose" style="background:none; border:none; color:var(--paper); cursor:pointer; font-size:18px; line-height:1;">×</button>
    </div>
    <div id="chatMessages" style="flex:1; overflow-y:auto; padding:14px; display:flex; flex-direction:column; gap:10px; font-size:13px;"></div>
    <div style="border-top:1px solid var(--line); padding:10px; display:flex; gap:8px;">
      <input id="chatInput" type="text" placeholder="Type a message..." style="flex:1; border:1px solid var(--line); border-radius:8px; padding:9px 12px; font-size:13px; font-family:'IBM Plex Sans';" />
      <button id="chatSend" class="btn btn-primary" style="padding:9px 14px;">Send</button>
    </div>
  </div>
</div>

<script>
(function () {
  var toggle = document.getElementById('chatToggle');
  var panel = document.getElementById('chatPanel');
  var closeBtn = document.getElementById('chatClose');
  var input = document.getElementById('chatInput');
  var sendBtn = document.getElementById('chatSend');
  var messagesEl = document.getElementById('chatMessages');
  var history = [];

  function open() { panel.style.display = 'flex'; if (messagesEl.children.length === 0) addBotMessage("Hi! I'm the Vromonsathi assistant. Ask me about destinations, tour packages, prices, spots left, or your own bookings."); }
  function close() { panel.style.display = 'none'; }

  toggle.addEventListener('click', function () { panel.style.display === 'flex' ? close() : open(); });
  closeBtn.addEventListener('click', close);

  function addMessage(text, isUser) {
    var bubble = document.createElement('div');
    bubble.style.maxWidth = '85%';
    bubble.style.padding = '9px 12px';
    bubble.style.borderRadius = '12px';
    bubble.style.lineHeight = '1.4';
    bubble.style.whiteSpace = 'pre-wrap';
    if (isUser) {
      bubble.style.alignSelf = 'flex-end';
      bubble.style.background = 'var(--forest)';
      bubble.style.color = 'var(--paper)';
    } else {
      bubble.style.alignSelf = 'flex-start';
      bubble.style.background = 'var(--paper-deep)';
      bubble.style.color = 'var(--ink)';
    }
    bubble.textContent = text;
    messagesEl.appendChild(bubble);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function addBotMessage(text) { addMessage(text, false); }
  function addUserMessage(text) { addMessage(text, true); }

  async function sendMessage() {
    var text = input.value.trim();
    if (!text) return;
    addUserMessage(text);
    input.value = '';
    sendBtn.disabled = true;

    var typingBubble = document.createElement('div');
    typingBubble.textContent = 'Typing...';
    typingBubble.style.alignSelf = 'flex-start';
    typingBubble.style.fontSize = '12px';
    typingBubble.style.opacity = '0.6';
    messagesEl.appendChild(typingBubble);
    messagesEl.scrollTop = messagesEl.scrollHeight;

    try {
      var res = await fetch('/ChatBot/Ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, history: history })
      });
      var data = await res.json();
      typingBubble.remove();
      addBotMessage(data.reply);
      history.push({ role: 'user', content: text });
      history.push({ role: 'assistant', content: data.reply });
    } catch (err) {
      typingBubble.remove();
      addBotMessage('Sorry, something went wrong. Please try again.');
    }
    sendBtn.disabled = false;
  }

  sendBtn.addEventListener('click', sendMessage);
  input.addEventListener('keydown', function (e) { if (e.key === 'Enter') sendMessage(); });
})();
</script>
</body>
</html>