@model List<Destination>
@{
    ViewData["Title"] = "Destinations";
}

<section>
    <div class="wrap">
        <div class="section-head">
            <div>
                <span class="tag">Destination-wise plans</span>
                <h2>Every region plans differently</h2>
                <p>Search or browse every destination, its checkpoints, and vendor listings.</p>
            </div>
            <form method="get" style="display:flex; gap:10px; flex-wrap:wrap;">
                <input type="text" name="search" placeholder="Search by name or district" value="@Context.Request.Query["search"]"
                       style="padding:10px 12px; border:1px solid var(--line); border-radius:8px; min-width:200px;" />
                <select name="district" style="min-width:150px;">
                    <option value="">All Districts</option>
                    @foreach (var dist in (List<string>)ViewBag.Districts)
                    {
                        <option value="@dist" selected="@(Context.Request.Query["district"] == dist)">@dist</option>
                    }
                </select>
                <select name="category" style="min-width:150px;">
                    <option value="">All Categories</option>
                    @foreach (var cat in (List<string>)ViewBag.Categories)
                    {
                        <option value="@cat" selected="@(Context.Request.Query["category"] == cat)">@cat</option>
                    }
                </select>
                <button class="btn btn-primary" type="submit">Search</button>
            </form>
        </div>

        <div class="dest-grid">
            @foreach (var d in Model)
            {
                var army = d.Checkpoints.Count(c => c.Type == CheckpointType.Army);
                var bgb = d.Checkpoints.Count(c => c.Type == CheckpointType.BGB);
                var police = d.Checkpoints.Count(c => c.Type == CheckpointType.Police);
                var bg = string.IsNullOrEmpty(d.ImageUrl) ? "background:linear-gradient(135deg,#1B4332,#0B2B20);" : $"background-image:url('{d.ImageUrl}');";

                <a class="dest-card" asp-controller="Destination" asp-action="Details" asp-route-id="@d.Id">
                    <div class="dest-photo" style="@bg"><span>@d.Division</span></div>
                    <div class="dest-body">
                        <span class="region">@d.District</span>
                        <h3>@d.Name</h3>
                        <p style="font-size:12.5px; opacity:0.75;">@d.Description</p>
                        <div class="dest-meta">
                            <div><span class="k">Entry fee</span><span class="v">৳@d.EntryFee</span></div>
                            <div><span class="k">Best time</span><span class="v">@d.BestTimeToVisit</span></div>
                        </div>
                        <div class="checkpoint-tags">
                            @if (army > 0)
                            {
                                <span class="cp-tag cp-army"><span class="cp-dot"></span>@army army</span>
                            }
                            @if (bgb > 0)
                            {
                                <span class="cp-tag cp-bgb"><span class="cp-dot"></span>@bgb BGB</span>
                            }
                            @if (police > 0)
                            {
                                <span class="cp-tag cp-police"><span class="cp-dot"></span>@police police</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
        @if (Model.Count == 0)
        {
            <p style="opacity:0.7; margin-top:20px;">No destinations found.</p>
        }
    </div>
</section>