@model List<VendorProfile>
@{
    ViewData["Title"] = "Manage Vendors";
}

<h2 class="mb-4">Manage Vendors</h2>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Business</th><th>Type</th><th>Owner</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td>@v.BusinessName</td>
                    <td>@v.BusinessType</td>
                    <td>@v.User.FullName (@v.User.Email)</td>
                    <td>@(v.IsApproved ? "Approved" : "Pending")</td>
                    <td>
                        @if (!v.IsApproved)
                        {
                            <a asp-action="ApproveVendor" asp-route-id="@v.Id" class="btn btn-sm btn-success">Approve</a>
                        }
                        else
                        {
                            <a asp-action="RejectVendor" asp-route-id="@v.Id" class="btn btn-sm btn-danger">Revoke</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>