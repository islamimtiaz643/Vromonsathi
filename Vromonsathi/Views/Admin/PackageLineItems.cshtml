@model List<PackageLineItem>
@{
    ViewData["Title"] = "Package Line Items"; var pkg = ViewBag.Package as TourPackage;
}

<h2 class="mb-2">Cost Breakdown — @pkg.Title</h2>
<p class="text-muted mb-4">
    Package price: ৳@pkg.Price &nbsp;|&nbsp;
    Mandatory total: ৳@ViewBag.MandatoryTotal &nbsp;|&nbsp;
    <strong>Flexible budget per person: ৳@ViewBag.FlexibleBudget</strong>
</p>

<a asp-action="CreatePackageLineItem" asp-route-packageId="@pkg.Id" class="btn btn-success mb-3">+ Add Line Item</a>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Label</th><th>Category</th><th>Cost</th><th>Mandatory</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td>@l.Label</td>
                    <td>@l.Category</td>
                    <td>৳@l.Cost</td>
                    <td>@(l.IsMandatory ? "Yes (included)" : "No (optional)")</td>
                    <td><a asp-action="DeletePackageLineItem" asp-route-id="@l.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete?');">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<a asp-action="TourPackages" class="btn btn-secondary">Back to Tour Packages</a>